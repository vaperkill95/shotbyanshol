# ShotByAnshol environment variables
# Copy this file to ".env.local" and fill in values as each phase needs them.
# Phase 1 (scaffold + deploy) needs NONE of these — the site runs without them.

# --- Phase 2: Neon (Postgres database) ---
# From your Neon project dashboard → Connection string (pooled).
DATABASE_URL=

# --- Phase 3: Cloudflare R2 (photo + video storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shotbyanshol-media
# Public URL for the bucket (set after enabling public access / custom domain)
R2_PUBLIC_URL=

# --- Phase 4: Resend (contact form email) ---
RESEND_API_KEY=
# Where contact form notifications get sent
CONTACT_NOTIFY_EMAIL=

# --- Phase 5: Better Auth (admin login) ---
# Generate a long random string for this (we'll cover how in Phase 5).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
